# Copia este archivo como .env y ajusta los valores
PORT=3100
NODE_ENV=development
# Base de DESARROLLO (la levanta docker-compose.yml de esta carpeta)
DATABASE_URL="postgresql://liftsafe:liftsafe@localhost:5433/liftsafe_t6?schema=public"
# JWT: usa una clave larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-de-32+"
JWT_EXPIRES_IN="1h"
# Contraseña de los usuarios demo que crea el seed (npm run db:seed)
SEED_PASSWORD="LiftSafe2026!"
