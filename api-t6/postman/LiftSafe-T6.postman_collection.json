    {
      "name": "08 Listar ascensores (INTEGRADOR)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenIntegrador}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/elevators?page=1&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "elevators"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con contrato paginado', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b).to.have.all.keys('data','total','page','limit'); pm.expect(b.limit).to.eql(5); });",
              "pm.test('Responde en menos de 1 s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
