        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@liftsafe.test\",\n  \"password\": \"NoEsLaClave1\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 sin token', () => { pm.response.to.have.status(401); pm.expect(pm.response.json()).to.not.have.property('data'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Login con correo inválido → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
