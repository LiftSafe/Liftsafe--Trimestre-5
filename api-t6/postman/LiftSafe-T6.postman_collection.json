        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"no-es-correo\",\n  \"password\": \"12345678\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 con detalle de validación', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().issues).to.be.an('array').that.is.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Perfil del token (GET /auth/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
