  "info": {
    "_postman_id": "4c602502-d315-4a47-8eb9-b831bc470002",
    "name": "LiftSafe — 4.° backend (T6) · API de integración con JWT",
    "description": "Ejecuta en orden (Runner o `npx newman run`). Los tests guardan los tokens y los ids en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Salud del servicio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y status ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login ADMIN (guarda el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@liftsafe.test\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con token JWT', () => { pm.response.to.have.status(200); const d = pm.response.json().data; pm.expect(d.token.split('.')).to.have.lengthOf(3); pm.expect(d.user.role).to.eql('ADMIN'); pm.collectionVariables.set('tokenAdmin', d.token); });",
              "pm.test('No devuelve la contraseña', () => { pm.expect(pm.response.text()).to.not.include('passwordHash'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login INTEGRADOR (guarda el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"integrador@liftsafe.test\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con rol INTEGRADOR', () => { pm.response.to.have.status(200); const d = pm.response.json().data; pm.expect(d.user.role).to.eql('INTEGRADOR'); pm.collectionVariables.set('tokenIntegrador', d.token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login con contraseña errada → 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
