        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con el correo del token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.email).to.eql('admin@liftsafe.test'); });"
            ]
          }
        }
      ]
    },
