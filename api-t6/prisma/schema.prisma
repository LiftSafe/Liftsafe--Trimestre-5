// LiftSafe — 4.° backend (T6): API de integración con autenticación JWT.
// Recursos: ascensores, edificios y los usuarios que consumen la API.

generator client {
  provider   = "prisma-client-js"
  // Cliente sin binario de Rust: usa el driver de PostgreSQL (adapter-pg)
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ElevatorType {
  ELECTRICO
  HIDRAULICO
  PANORAMICO
  MONTACARGAS
}

enum ElevatorStatus {
  ACTIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

// ADMIN: puede crear, editar y borrar. INTEGRADOR: solo consulta (app móvil, IoT, terceros).
enum Role {
  ADMIN
  INTEGRADOR
}

// Recurso secundario: un edificio tiene muchos ascensores
model Building {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  address   String
  city      String
  floors    Int
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  elevators Elevator[]

  @@map("buildings")
}

// Recurso principal: cada ascensor pertenece a un edificio
model Elevator {
  id           String         @id @default(uuid()) @db.Uuid
  internalCode String         @unique @map("internal_code")
  brand        String
  model        String
  type         ElevatorType
  capacityKg   Int            @map("capacity_kg")
  stops        Int
  status       ElevatorStatus @default(ACTIVO)
  installedAt  DateTime?      @map("installed_at") @db.Date
  buildingId   String         @map("building_id") @db.Uuid
  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([buildingId])
  @@map("elevators")
}

// Cuentas que pueden pedir un token (la contraseña se guarda con bcrypt)
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(INTEGRADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
