{
  "name": "liftsafe-api-semana05",
  "version": "1.0.0",
  "private": true,
  "description": "LiftSafe — API de ascensores con PostgreSQL y Prisma ORM (migraciones, seed y errores de BD)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "morgan": "1.10.0",
    "winston": "3.17.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  }
}
