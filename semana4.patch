+"""Pruebas de API — ángulo BD: respuestas que dependen de lo que hay guardado.
+
+Duplicados (409), registros con dependientes (409) y búsquedas. Todo con la
+sesión simulada: no se toca ninguna base de datos.
+"""
+from tests.fakes import auth, fila
+
+ASCENSOR_VALIDO = {
+    "id_cliente": 5,
+    "codigo_interno": "ASC-001",
+    "marca": "Otis",
+    "modelo": "Gen2",
+    "numero_serie": "SN-1",
+    "tipo_ascensor": "Pasajeros",
+    "capacidad_kg": 630,
+    "numero_pisos": 8,
+    "ubicacion_exacta": "Torre A",
+    "direccion_completa": "Cra 1 # 2-3",
+    "ciudad": "Bogotá",
+    "estado": "Activo",
+}
+
+
+def test_crear_ascensor_con_codigo_repetido_responde_409(client, db):
+    # Arrange: el cliente existe y YA hay un ascensor con ese código interno
+    db.firsts = [fila(id_usuario=5), fila(id_ascensor=7)]
+
+    # Act
+    respuesta = client.post("/ascensores/", json=ASCENSOR_VALIDO, headers=auth("Administrador"))
+
+    # Assert
+    assert respuesta.status_code == 409
+    assert respuesta.json() == {"detail": "El código interno ya está registrado"}
+    assert db.commits == 0  # no se guardó nada
+
+
+def test_eliminar_ascensor_con_inspecciones_responde_409_y_no_lo_borra(client, db):
+    db.firsts = [fila(id_ascensor=1, inspecciones=[object()])]
+
+    respuesta = client.delete("/ascensores/1", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 409
+    assert "tiene inspecciones asociadas" in respuesta.json()["detail"]
+    assert db.deleted == []
+
+
+def test_crear_sede_con_nombre_repetido_responde_409(client, db):
+    # Arrange: el cliente existe y ya tiene una sede con ese nombre
+    db.firsts = [fila(id_usuario=5), fila(id_sede=3)]
+
+    respuesta = client.post("/clientes/5/sedes", json={"nombre": "Norte"}, headers=auth("Administrador"))
+
+    assert respuesta.status_code == 409
+    assert respuesta.json() == {"detail": "Este cliente ya tiene una sede con ese nombre"}
+
+
+def test_eliminar_sede_con_ascensores_responde_409_y_no_la_borra(client, db):
+    db.firsts = [fila(id_sede=3)]
+    db.count_value = 2  # la sede tiene 2 ascensores
+
+    respuesta = client.delete("/clientes/sedes/3", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 409
+    assert respuesta.json()["detail"].startswith("No se puede eliminar: la sede tiene 2 ascensor(es)")
+    assert db.deleted == []
+
+
+def test_eliminar_sede_sin_ascensores_responde_200(client, db):
+    sede = fila(id_sede=3)
+    db.firsts = [sede]
+    db.count_value = 0
+
+    respuesta = client.delete("/clientes/sedes/3", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 200
+    assert respuesta.json() == {"message": "Sede eliminada"}
+    assert db.deleted == [sede]
+
+
+def test_listar_sedes_de_un_cliente_incluye_el_total_de_ascensores_de_cada_una(client, db):
+    # Arrange: 1) el cliente  2) sus sedes  3) conteo (id_sede, total) por sede
+    sede = fila(id_sede=3, id_cliente=5, nombre="Norte", direccion="Cra 1", ciudad="Bogotá")
+    db.firsts = [fila(id_usuario=5)]
+    db.alls = [[sede], [(3, 2)]]
+
+    respuesta = client.get("/clientes/5/sedes", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 200
+    assert respuesta.json() == [
+        {"id_sede": 3, "id_cliente": 5, "nombre": "Norte", "direccion": "Cra 1", "ciudad": "Bogotá", "total_ascensores": 2}
+    ]
+
+
+def test_listar_sedes_de_un_cliente_inexistente_responde_404(client, db):
+    db.firsts = [None]
+
+    respuesta = client.get("/clientes/999/sedes", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 404
+    assert respuesta.json() == {"detail": "Cliente no encontrado"}
+
+
+def test_registro_con_correo_ya_registrado_responde_409(client, db):
+    db.firsts = [fila(id_usuario=1)]  # el correo ya existe
+    datos = {
+        "nombre_completo": "Ana Pérez",
+        "correo": "ana@example.com",
+        "contrasena": "Segura2024x",
+        "tipo_documento": "CC",
+        "documento_identidad": "123456789",
+    }
+
+    respuesta = client.post("/auth/register", json=datos)
+
+    assert respuesta.status_code == 409
+    assert respuesta.json() == {"detail": "El correo ya está registrado"}
diff --git a/liftsafe-backend/tests/test_api_front.py b/liftsafe-backend/tests/test_api_front.py
new file mode 100644
index 0000000..4ce9e02
--- /dev/null
+++ b/liftsafe-backend/tests/test_api_front.py
@@ -0,0 +1,110 @@
+"""Pruebas de API — ángulo Front: el contrato exacto que consume la interfaz.
+
+Se verifican los campos del JSON que React lee (LiftSafe_FrontendV2/src/services)
+y el formato de error que la interfaz muestra (`detail` como texto o como lista
+con `msg`, ver apiClient.js).
+"""
+from datetime import datetime
+
+from jose import jwt
+
+from app.config import settings
+from tests.fakes import auth, fila
+
+
+def test_login_exitoso_entrega_los_campos_que_guarda_el_frontend(client, monkeypatch):
+    # Arrange: se simula la validación de credenciales (AES_DECRYPT necesita MySQL real)
+    usuario = fila(correo="ana@example.com", id_usuario=7, nombre_completo="Ana Pérez", rol=fila(nombre_rol="Cliente"))
+    monkeypatch.setattr("app.routes.auth.authenticate_user", lambda db, correo, clave: usuario)
+
+    # Act
+    respuesta = client.post("/auth/login", json={"correo": "ana@example.com", "contrasena": "Segura2024x"})
+
+    # Assert
+    cuerpo = respuesta.json()
+    assert respuesta.status_code == 200
+    assert respuesta.headers["content-type"] == "application/json"
+    assert set(cuerpo) == {"access_token", "token_type", "rol", "nombre"}
+    assert cuerpo["token_type"] == "bearer"
+    assert (cuerpo["rol"], cuerpo["nombre"]) == ("Cliente", "Ana Pérez")
+
+
+def test_el_token_del_login_lleva_el_usuario_y_el_rol(client, monkeypatch):
+    usuario = fila(correo="ana@example.com", id_usuario=7, nombre_completo="Ana", rol=fila(nombre_rol="Inspector"))
+    monkeypatch.setattr("app.routes.auth.authenticate_user", lambda db, correo, clave: usuario)
+
+    token = client.post("/auth/login", json={"correo": "ana@example.com", "contrasena": "x"}).json()["access_token"]
+
+    payload = jwt.decode(token, settings.SECRET_KEY, algorithms=[settings.ALGORITHM])
+    assert (payload["user_id"], payload["rol"], payload["sub"]) == (7, "Inspector", "ana@example.com")
+
+
+def test_login_con_credenciales_incorrectas_responde_401_con_detail_de_texto(client, monkeypatch):
+    monkeypatch.setattr("app.routes.auth.authenticate_user", lambda db, correo, clave: None)
+
+    respuesta = client.post("/auth/login", json={"correo": "ana@example.com", "contrasena": "mala"})
+
+    assert respuesta.status_code == 401
+    assert respuesta.json() == {"detail": "Credenciales incorrectas"}
+    assert respuesta.headers["content-type"] == "application/json"
+
+
+def test_login_con_correo_invalido_responde_422_con_lista_de_errores_con_msg(client):
+    respuesta = client.post("/auth/login", json={"correo": "no-es-un-correo", "contrasena": "x"})
+
+    assert respuesta.status_code == 422
+    errores = respuesta.json()["detail"]
+    assert errores[0]["loc"] == ["body", "correo"]
+    assert "msg" in errores[0]  # apiClient.js une los `msg` para mostrarlos
+
+
+def test_auth_me_entrega_los_campos_del_perfil(client, db):
+    # Arrange: la consulta devuelve (Usuario, nombre_rol)
+    usuario = fila(
+        id_usuario=7, nombre_completo="Ana Pérez", correo="ana@example.com", telefono="3001234567",
+        tipo_documento="CC", documento_identidad="123", estado="activo", fecha_registro=datetime(2026, 1, 5),
+    )
+    db.firsts = [(usuario, "Cliente")]
+
+    respuesta = client.get("/auth/me", headers=auth("Cliente", 7, correo="ana@example.com"))
+
+    assert respuesta.status_code == 200
+    assert respuesta.json() == {
+        "id_usuario": 7,
+        "nombre_completo": "Ana Pérez",
+        "correo": "ana@example.com",
+        "rol": "Cliente",
+        "telefono": "3001234567",
+        "tipo_documento": "CC",
+        "documento_identidad": "123",
+        "estado": "activo",
+        "fecha_registro": "2026-01-05T00:00:00",
+    }
+
+
+def test_listado_de_ascensores_entrega_exactamente_los_campos_que_usa_la_tabla(client, db):
+    ascensor = fila(
+        id_ascensor=1, codigo_interno="ASC-001", marca="Otis", modelo="Gen2", tipo_ascensor="Pasajeros",
+        capacidad_kg=630, ciudad="Bogotá", estado="Activo", id_sede=None, sede=None,
+    )
+    db.alls = [[(ascensor, "Edificio Central")]]
+
+    respuesta = client.get("/ascensores/listado", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 200
+    fila_json = respuesta.json()[0]
+    assert set(fila_json) == {
+        "id_ascensor", "codigo_interno", "marca", "modelo", "tipo_ascensor",
+        "capacidad_kg", "ciudad", "estado", "cliente", "id_sede", "sede",
+    }
+    assert fila_json["cliente"] == "Edificio Central"
+    assert fila_json["sede"] is None
+
+
+def test_listado_de_ascensores_de_un_cliente_que_no_existe_en_la_bd_responde_404(client, db):
+    db.firsts = [None]
+
+    respuesta = client.get("/ascensores/listado", headers=auth("Cliente", 7))
+
+    assert respuesta.status_code == 404
+    assert respuesta.json() == {"detail": "Usuario no encontrado"}
diff --git a/liftsafe-backend/tests/test_api_seguridad.py b/liftsafe-backend/tests/test_api_seguridad.py
new file mode 100644
index 0000000..13dbbd0
--- /dev/null
+++ b/liftsafe-backend/tests/test_api_seguridad.py
@@ -0,0 +1,185 @@
+"""Pruebas de API — ángulo E2E (transversal): seguridad y contrato de errores.
+
+Parte 1: endpoints protegidos con los tres casos (401, 403, autorizado).
+Parte 2: el contrato de errores de TODO el API: siempre JSON con `detail` y
+         sin stack traces, SQL ni mensajes internos.
+"""
+import pytest
+
+from tests.fakes import FakeSession, auth, token_vencido
+
+ASCENSOR = {
+    "id_cliente": 5, "codigo_interno": "A-1", "marca": "Otis", "modelo": "G", "numero_serie": "S",
+    "tipo_ascensor": "P", "capacidad_kg": 1, "numero_pisos": 1, "ubicacion_exacta": "x",
+    "direccion_completa": "x", "ciudad": "x", "estado": "Activo",
+}
+
+# (método, ruta, cuerpo) de endpoints que exigen sesión
+PROTEGIDOS = [
+    ("get", "/auth/me", None),
+    ("get", "/ascensores/listado", None),
+    ("post", "/ascensores/", ASCENSOR),
+    ("delete", "/ascensores/1", None),
+    ("get", "/clientes/", None),
+    ("get", "/usuarios/listado", None),
+    ("delete", "/usuarios/1", None),
+    ("get", "/usuarios/perfil/1", None),
+    ("get", "/usuarios/dashboard/admin", None),
+    ("get", "/usuarios/dashboard/cliente/1", None),
+    ("get", "/usuarios/dashboard/inspector/1", None),
+]
+
+
+def _enviar(client, metodo, ruta, cuerpo, headers=None):
+    return getattr(client, metodo)(ruta, headers=headers, **({"json": cuerpo} if cuerpo else {}))
+
+
+# ── 401: sin autenticar ──────────────────────────────────────────────────────
+@pytest.mark.parametrize("metodo,ruta,cuerpo", PROTEGIDOS)
+def test_endpoint_protegido_sin_token_responde_401(client, metodo, ruta, cuerpo):
+    respuesta = _enviar(client, metodo, ruta, cuerpo)
+
+    assert respuesta.status_code == 401
+    assert isinstance(respuesta.json()["detail"], str)
+
+
+def test_token_basura_responde_401_sin_filtrar_el_mensaje_interno_de_la_libreria(client):
+    respuesta = client.get("/usuarios/perfil/1", headers={"Authorization": "Bearer abc.def.ghi"})
+
+    assert respuesta.status_code == 401
+    assert respuesta.json() == {"detail": "Token inválido"}
+
+
+def test_token_vencido_responde_401(client):
+    respuesta = client.get("/ascensores/listado", headers={"Authorization": f"Bearer {token_vencido()}"})
+
+    assert respuesta.status_code == 401
+    assert respuesta.json() == {"detail": "Token inválido"}
+
+
+def test_token_firmado_con_otra_clave_responde_401(client):
+    from jose import jwt
+
+    falso = jwt.encode({"user_id": 1, "rol": "Administrador"}, "clave-del-atacante", algorithm="HS256")
+
+    respuesta = client.get("/ascensores/listado", headers={"Authorization": f"Bearer {falso}"})
+
+    assert respuesta.status_code == 401
+
+
+# ── 403: autenticado pero sin permiso ────────────────────────────────────────
+def test_cliente_no_puede_listar_clientes_responde_403(client):
+    respuesta = client.get("/clientes/", headers=auth("Cliente"))
+
+    assert respuesta.status_code == 403
+    assert respuesta.json() == {"detail": "No autorizado para ver los clientes"}
+
+
+def test_inspector_no_puede_crear_ascensores_responde_403(client):
+    respuesta = client.post("/ascensores/", json=ASCENSOR, headers=auth("Inspector"))
+
+    assert respuesta.status_code == 403
+    assert respuesta.json() == {"detail": "No autorizado para crear ascensores"}
+
+
+def test_director_tecnico_no_puede_eliminar_ascensores_responde_403(client):
+    respuesta = client.delete("/ascensores/1", headers=auth("Director Técnico"))
+
+    assert respuesta.status_code == 403
+
+
+def test_coordinador_no_puede_eliminar_usuarios_responde_403(client):
+    respuesta = client.delete("/usuarios/1", headers=auth("Coordinador"))
+
+    assert respuesta.status_code == 403
+    assert respuesta.json() == {"detail": "Solo el administrador puede realizar esta acción"}
+
+
+def test_cliente_no_puede_crear_sedes_responde_403(client):
+    respuesta = client.post("/clientes/5/sedes", json={"nombre": "Norte"}, headers=auth("Cliente", 5))
+
+    assert respuesta.status_code == 403
+
+
+# ── Autorizado ───────────────────────────────────────────────────────────────
+def test_administrador_lista_clientes_responde_200(client):
+    respuesta = client.get("/clientes/", headers=auth("Administrador"))
+
+    assert respuesta.status_code == 200
+    assert respuesta.json() == []
+
+
+def test_usuario_autenticado_consulta_un_perfil_responde_200(client, db):
+    db.exec_rows = [{
+        "id_usuario": 1, "nombre_completo": "Ana", "correo": "ana@example.com",
+        "nombre_rol": "Cliente", "telefono": None, "estado": "activo", "id_rol": 6,
+    }]
+
+    respuesta = client.get("/usuarios/perfil/1", headers=auth("Cliente", 1))
+
+    assert respuesta.status_code == 200
+    assert respuesta.json()["rol"] == "Cliente"
+
+
+def test_administrador_crea_una_sede_responde_201_con_la_sede(client, db):
+    from tests.fakes import fila
+
+    db.firsts = [fila(id_usuario=5), None]  # el cliente existe; no hay sede repetida
+
+    respuesta = client.post(
+        "/clientes/5/sedes",
+        json={"nombre": "Norte", "direccion": "Cra 1", "ciudad": "Bogotá"},
+        headers=auth("Administrador"),
+    )
+
+    assert respuesta.status_code == 201
+    assert respuesta.json() == {
+        "id_sede": 99, "id_cliente": 5, "nombre": "Norte", "direccion": "Cra 1",
+        "ciudad": "Bogotá", "total_ascensores": 0,
+    }
+
+
+# ── Contrato de errores de todo el API ───────────────────────────────────────
+def test_json_mal_formado_responde_400_con_detail_json(client):
+    respuesta = client.post("/auth/login", content='{"correo":', headers={"Content-Type": "application/json"})
+
+    assert respuesta.status_code == 400
+    assert respuesta.json() == {"detail": "Cuerpo de la petición mal formado"}
+    assert respuesta.headers["content-type"] == "application/json"
+
+
+def test_tipos_incorrectos_responden_422_con_el_campo_en_error(client):
+    respuesta = client.post("/auth/login", json={"correo": 123, "contrasena": ["x"]})
+
+    assert respuesta.status_code == 422
+    campos = {tuple(e["loc"]) for e in respuesta.json()["detail"]}
+    assert ("body", "correo") in campos
+
+
+def test_ruta_inexistente_responde_404_en_json(client):
+    respuesta = client.get("/esta-ruta-no-existe")
+
+    assert respuesta.status_code == 404
+    assert respuesta.json() == {"detail": "Not Found"}
+
+
+def test_metodo_no_permitido_responde_405_en_json(client):
+    respuesta = client.delete("/auth/login")
+
+    assert respuesta.status_code == 405
+    assert isinstance(respuesta.json()["detail"], str)
+
+
+def test_error_inesperado_responde_500_json_sin_sql_ni_stack_trace(client, db):
+    # Arrange: la BD "se cae" con un mensaje que contiene SQL y datos internos
+    db.error = RuntimeError("(pymysql.err.OperationalError) (2003, \"Can't connect\") SELECT * FROM usuario WHERE clave='x'")
+
+    # Act
+    respuesta = client.get("/ascensores/listado", headers=auth("Administrador"))
+
+    # Assert
+    assert respuesta.status_code == 500
+    assert respuesta.headers["content-type"] == "application/json"
+    assert respuesta.json() == {"detail": "Error interno del servidor"}
+    for pista in ("SELECT", "pymysql", "Traceback", "RuntimeError", "usuario"):
+        assert pista not in respuesta.text
