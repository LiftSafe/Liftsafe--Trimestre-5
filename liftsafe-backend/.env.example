# Copia este archivo como .env y ajusta tus credenciales.
# El .env NUNCA debe subirse a git (ya está en .gitignore).

# ── Base de datos MySQL ──────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=liftsafe_db

# ── JWT (firma de tokens de sesión) ──────────────────────────────────
# Genera una clave propia y aleatoria, no la compartas ni la subas a git.
# Ejemplo para generar una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ── Clave AES de MySQL ───────────────────────────────────────────────
# Usada por AES_ENCRYPT/AES_DECRYPT para cifrar la columna
# usuario.contrasena_encriptada. Debe coincidir EXACTAMENTE con la clave
# usada al crear los usuarios en liftsafe_db.sql, o ningún login existente
# funcionará. No la cambies salvo que vayas a re-encriptar todas las
# contraseñas de la base de datos.
SECRET_KEY_MYSQL=LiftSafeSecretKey2026!

# ── Correo (Gmail con SSL) - usado para recuperación de contraseña ──
# MAIL_PASSWORD es una "contraseña de aplicación" de Gmail (no tu clave
# normal de Gmail): actívala en https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion-de-gmail
MAIL_FROM=tu-correo@gmail.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
